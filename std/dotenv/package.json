{
  "name": "@neostd/dotenv",
  "version": "0.0.0-alpha.0",
  "description": "Parse, stringify, expand, and load dotenv content.",
  "keywords": [
    "dotenv",
    "env",
    "environment",
    "parse",
    "stringify"
  ],
  "homepage": "https://github.com/neostd/js/tree/dev/std/dotenv#readme",
  "bugs": {
    "url": "https://github.com/neostd/js/issues"
  },
  "license": "MIT",
  "author": "Mr. Neobeard <mrneobeard@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neostd/js.git"
  },
  "files": [
    "esm"
  ],
  "type": "module",
  "exports": {
    ".": "./esm/index.mjs",
    "./document": "./esm/document.mjs",
    "./expand": "./esm/expand.mjs",
    "./load": "./esm/load.mjs",
    "./parse": "./esm/parse.mjs",
    "./parse_document": "./esm/parse_document.mjs",
    "./stringify": "./esm/stringify.mjs",
    "./stringify_document": "./esm/stringify_document.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:bun": "bun test",
    "test:deno": "deno test -A --no-check",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "fix": "vp check --fix",
    "update": "vp pack && vp check --fix && vp test && vp run test:deno && vp run test:bun"
  },
  "dependencies": {
    "@neostd/chars": "workspace:*",
    "@neostd/env": "workspace:*",
    "@neostd/strings": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
