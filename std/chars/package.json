{
  "name": "@neostd/chars",
  "version": "0.0.0-alpha.0",
  "description": "Utf8 character utilities like isDigit, isUpper, toLower, isSymbol, isSpace, isPunc, simpleFold.",
  "keywords": [
    "chars",
    "characters",
    "simplefold",
    "unicode",
    "runes"
  ],
  "homepage": "https://github.com/neostd/js#README.md",
  "bugs": {
    "url": "https://github.com/netstd/js/issues"
  },
  "license": "MIT",
  "author": "Mr. Neobeard <mrneobeard@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neostd/js.git"
  },
  "files": [
    "esm"
  ],
  "type": "module",
  "exports": {
    ".": "./esm/index.mjs",
    "./all": "./esm/all.mjs",
    "./constants": "./esm/constants.mjs",
    "./is-ascii": "./esm/is-ascii.mjs",
    "./is-char": "./esm/is-char.mjs",
    "./is-control": "./esm/is-control.mjs",
    "./is-digit": "./esm/is-digit.mjs",
    "./is-latin1": "./esm/is-latin1.mjs",
    "./is-letter": "./esm/is-letter.mjs",
    "./is-letter-or-digit": "./esm/is-letter-or-digit.mjs",
    "./is-lower": "./esm/is-lower.mjs",
    "./is-punc": "./esm/is-punc.mjs",
    "./is-space": "./esm/is-space.mjs",
    "./is-symbol": "./esm/is-symbol.mjs",
    "./is-upper": "./esm/is-upper.mjs",
    "./simple-fold": "./esm/simple-fold.mjs",
    "./tables/l": "./esm/tables/l.mjs",
    "./tables/latin1": "./esm/tables/latin1.mjs",
    "./tables/ll": "./esm/tables/ll.mjs",
    "./tables/lu": "./esm/tables/lu.mjs",
    "./tables/nd": "./esm/tables/nd.mjs",
    "./tables/p": "./esm/tables/p.mjs",
    "./tables/s": "./esm/tables/s.mjs",
    "./to-lower": "./esm/to-lower.mjs",
    "./to-upper": "./esm/to-upper.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:bun": "bun run test",
    "test:deno": "deno task test",
    "test:all": "vp run test:bun && vp run test:deno && vp run test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "fix": "vp check --fix"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
