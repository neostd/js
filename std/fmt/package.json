{
  "name": "@neostd/fmt",
  "version": "0.0.0-alpha.0",
  "description": "Sprintf, printf ported from @std/fmt.",
  "keywords": [
    "fmt",
    "format",
    "inspect",
    "printf"
  ],
  "homepage": "https://github.com/neostd/js/tree/dev/std/fmt#readme",
  "bugs": {
    "url": "https://github.com/neostd/js/issues"
  },
  "license": "MIT",
  "author": "Mr. Neobeard <mrneobeard@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neostd/js.git"
  },
  "files": [
    "esm"
  ],
  "type": "module",
  "exports": {
    ".": "./esm/index.mjs",
    "./inspect": "./esm/inspect.mjs",
    "./printf": "./esm/printf.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:bun": "bun test",
    "test:deno": "deno test -A --no-check",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "fix": "vp check --fix",
    "update": "vp pack && vp check --fix && vp test && vp run test:bun && vp run test:deno"
  },
  "dependencies": {
    "@neostd/process": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
